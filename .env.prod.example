# docker-compose.prod.yml uchun sozlamalar: bu faylni .env nomi bilan nusxalang va to'ldiring
# (.env git'ga kiritilmaydi)

# Faqat harf va raqamlar (DATABASE_URL ichiga qo'yiladi). Masalan: openssl rand -hex 16
POSTGRES_PASSWORD=
# Kamida 16 belgi, tasodifiy. Masalan: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Brauzer manzili (CORS). Frontend va API bir domenda bo'lsa (nginx orqali) bo'sh qoldirish mumkin
CORS_ORIGIN=
# Rasm URL'lari: bo'sh = nisbiy (/uploads/...), tavsiya etiladi
PUBLIC_BASE_URL=
MAX_UPLOAD_MB=10
TZ=Asia/Tashkent

# nginx: portlar va rejim. HTTPS: NGINX_CONF=nginx.tls.conf va deploy/certs/ ga sertifikat qo'ying
WEB_PORT=80
WEB_TLS_PORT=443
NGINX_CONF=nginx.conf
