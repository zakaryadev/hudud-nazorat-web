# PostgreSQL ulanishi
DATABASE_URL="postgresql://hudud:hudud@localhost:5432/hudud?schema=public"

# JWT
JWT_SECRET="o'z-maxfiy-kalitingni-qo'y-32-belgidan-ko'p"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000

# Fayllar saqlanadigan joy (o'z serveringda)
UPLOAD_DIR="./uploads"
# Public URL (frontend rasmlarni shu orqali oladi)
PUBLIC_BASE_URL="http://localhost:3000"

# Brauzer origin(lar)i, vergul bilan. Bo'sh = hamma (faqat dev!). Masalan: https://nazorat.example.uz
CORS_ORIGIN=""
# Fayl hajmi chegarasi (MB)
MAX_UPLOAD_MB=10
# Kun chegarasi (kunlik hisobot) uchun vaqt zonasi
TZ="Asia/Tashkent"
